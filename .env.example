# Copie este arquivo para `.env.local` e preencha com os dados do seu app Web no Firebase:
# Console do Firebase > Configurações do projeto > Seus apps > (ícone </>) > firebaseConfig
#
# Sem estas variáveis o app funciona em modo local (dados de exemplo, login só no aparelho).
# Depois de editar, reinicie o `npx expo start`.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
